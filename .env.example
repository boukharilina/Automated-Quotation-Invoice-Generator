# PostgreSQL. If DATABASE_URL is empty, an embedded PostgreSQL (PGlite) stored in ./data/pgdata is used (dev only).
DATABASE_URL=postgresql://edutest:edutest@localhost:5432/edutest
# Long random string used to sign session cookies (openssl rand -base64 32)
AUTH_SECRET=change-me-to-a-long-random-string
# First administrator, created only when the users table is empty
ADMIN_EMAIL=admin@edutest.tn
ADMIN_PASSWORD=Edutest2026!
# Envoi des devis et factures par e-mail (SMTP). Port 587 (STARTTLS) ou 465 (SSL).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Adresse d'expéditeur (par défaut : SMTP_USER)
SMTP_FROM=
